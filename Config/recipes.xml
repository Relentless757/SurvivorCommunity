<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<append xpath="/recipes">
		<!-- P2 (user, 2026-11-09): crafted from the backpack, no workbench -->
		<recipe name="scPackingStation" count="1" craft_time="60">
			<ingredient name="resourceWood" count="30"/>
			<ingredient name="resourceForgedIron" count="5"/>
			<ingredient name="resourceDuctTape" count="2"/>
		</recipe>
		<recipe name="scRadioStation" count="1" craft_time="120" craft_area="workbench" tags="workbenchCrafting">
			<ingredient name="resourceForgedIron" count="15"/>
			<ingredient name="resourceElectricParts" count="6"/>
			<ingredient name="resourceMechanicalParts" count="4"/>
			<ingredient name="resourceScrapPolymers" count="10"/>
		</recipe>
		<!-- R2 (round 27): the handheld radio - about half the station's electronics, no iron frame, taped together; it relays
		     through the station rather than replacing it -->
		<recipe name="scHandheldRadio" count="1" craft_time="60" craft_area="workbench" tags="workbenchCrafting">
			<ingredient name="resourceElectricParts" count="3"/>
			<ingredient name="resourceMechanicalParts" count="2"/>
			<ingredient name="resourceScrapPolymers" count="5"/>
			<ingredient name="resourceDuctTape" count="2"/>
		</recipe>
	</append>
	<!-- The Watch post (base defence D3): cheap, crafted in the backpack. Since 2026-10-07 it is the shape family's helper
	     (any shape from the shape menu); the old cube scWatchPost is no longer crafted. -->
	<append xpath="/recipes">
		<recipe name="scWatchPostShapes:VariantHelper" count="1" craft_time="10" tags="packMuleCrafting">
			<ingredient name="resourceWood" count="10" />
			<ingredient name="resourceNail" count="4" />
		</recipe>
	</append>
	<!-- The Guard Tower kit: its blocks' worth (the user's pick) - 76 wood shapes x 10 wood, 4 wooden ladders x 3, and
	     the Watch post's 10 wood + 4 nails. Crafted in the backpack like the post. -->
	<append xpath="/recipes">
		<recipe name="scGuardTower" count="1" craft_time="60" tags="packMuleCrafting">
			<ingredient name="resourceWood" count="782" />
			<ingredient name="resourceNail" count="4" />
		</recipe>
	</append>
	<!-- The Outpost Claim Block: a land claim plus cloth and scrap iron. -->
	<append xpath="/recipes">
		<recipe name="scOutpostFlag" count="1" craft_time="10" tags="packMuleCrafting">
			<ingredient name="resourceRockSmall" count="5" />
			<ingredient name="resourceCloth" count="5" />
			<ingredient name="resourceScrapIron" count="5" />
		</recipe>
	</append>
</configs>
