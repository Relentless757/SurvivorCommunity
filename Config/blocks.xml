	<append xpath="/blocks">
		<!-- The packing station: a lockable crate (vanilla loot window) whose contents the packing strip
		     in that window can turn into resource bundles. TEFeatureSCPacking is a marker the strip
		     recognises; the storage feature holds the items. Model: the vanilla writable wood crate. -->
		<block name="scPackingStation">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="CompositeTileEntity" />
			<property class="CompositeFeatures">
				<property class="TEFeatureStorage">
					<property name="LootList" value="scPackingInput" />
				</property>
				<property class="TEFeatureLockable" />
				<property class="TEFeatureSCPacking" />
			</property>
			<property name="DescriptionKey" value="scPackingStationDesc" />
			<property name="CustomIcon" value="cntWoodWritableCrate" />
			<property name="CustomIconTint" value="200,230,200" />
			<property name="Material" value="MwoodReinforced" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/LootContainers/woodWritableCratePrefab.prefab" />
			<property name="WaterFlow" value="permitted" />
			<property name="Path" value="solid" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="AllowedRotations" value="Basic90" />
			<property name="FuelValue" value="300" />
			<property name="EconomicValue" value="20" />
			<property name="MaxDamage" value="600" />
			<property name="SoundPickup" value="cratewood_grab" />
			<property name="SoundPlace" value="cratewood_place" />
			<property class="RepairItems">
				<property name="resourceWood" value="10" />
			</property>
			<drop event="Destroy" name="resourceWood" count="1,3" />
			<drop event="Fall" name="terrDestroyedWoodDebris" count="1" prob="0.75" stick_chance="1" />
			<property name="SortOrder1" value="B106" />
			<property name="SortOrder2" value="0001" />
			<property name="Group" value="Basics,Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_decor" />
		</block>
	</append>

	<append xpath="/blocks">
		<!-- The radio station: a powered consumer (wire it like a light). Its "Use radio" command opens the radio
		     window while it has power. Model: vanilla's ham radio prop. -->
		<block name="scRadioStation">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="ScRadio, SurvivorCommunity" />
			<property name="RequiredPower" value="5" />
			<property name="TakeDelay" value="2" />
			<property name="DescriptionKey" value="scRadioStationDesc" />
			<property name="CustomIcon" value="radioHam" />
			<property name="CustomIconTint" value="200,230,255" />
			<property name="Material" value="Mmetal_weak" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="@:Entities/Electrical/radioHamPrefab.prefab" />
			<property name="IsTerrainDecoration" value="true" />
			<property name="WaterFlow" value="permitted" />
			<property name="Place" value="TowardsPlacer" />
			<property name="AllowedRotations" value="Basic90" />
			<property name="EconomicValue" value="120" />
			<property name="MaxDamage" value="500" />
			<property name="SoundPickup" value="metal_grab" />
			<property name="SoundPlace" value="metal_place" />
			<property class="RepairItems">
				<property name="resourceElectricParts" value="2" />
			</property>
			<drop event="Destroy" name="resourceScrapIron" count="2,5" />
			<drop event="Fall" name="terrDestroyedStone" count="1" prob="0.75" stick_chance="1" />
			<property name="SortOrder1" value="B106" />
			<property name="SortOrder2" value="0002" />
			<property name="Group" value="Basics,Building,advBuilding,Science" />
			<property name="FilterTags" value="MC_playerBlocks,SC_decor" />
		</block>
	</append>
	<!-- The Outpost Flag: a land claim that establishes an outpost where it stands (inside a cleared building away
	     from home, radio on, fee paid - the same gates as the claim's "Establish outpost"); anywhere else it is an
	     ordinary claim. Same model and claim rules as the keystone (IndexName lpblock); TEFeatureSCCommunity.OnAdded. -->
	<append xpath="/blocks">
		<block name="scOutpostFlag">
			<property name="Extends" value="keystoneBlock" />
			<property name="CustomIcon" value="keystoneBlock" />
			<property name="CustomIconTint" value="FFBE5A" />
			<property name="DescriptionKey" value="scOutpostFlagDesc" />
			<property name="SortOrder2" value="0001" />
		</block>
	</append>
</configs>
