<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!-- The packing station's box: 8x4 player storage, never rolls loot. No lootgroup references, so it is
	     safe to append at the end of loot.xml (groups must be defined before first use; containers need not). -->
	<append xpath="/lootcontainers">
		<lootcontainer name="scPackingInput" count="0" size="8,4" sound_open="UseActions/crate_wood_open" sound_close="UseActions/crate_wood_close" loot_quality_template="qualBaseTemplate">
			<item name="cobweb" count="0"/>
		</lootcontainer>
		<!-- The linked storage views (home, an outpost's own boxes): never placed, never rolled. The loot window only
		     reads its sounds and open time; the view's title is passed separately (ScStorage.OpenWindow). -->
		<lootcontainer name="scLinkedStorage" count="0" size="9,4" sound_open="UseActions/crate_wood_open" sound_close="UseActions/crate_wood_close" open_time="0" loot_quality_template="qualBaseTemplate">
			<item name="cobweb" count="0"/>
		</lootcontainer>
	</append>

	<!-- Resource bundles in world loot (round wl: three sizes, Small 1 / Medium 2 / Large 3 units). Each goes into the
	     vanilla groups of the containers it belongs in: food piles and cupboards, medical piles / cabinets / coolers /
	     Pop-N-Pills, ammo piles / military lockers / Shotgun Messiah / ammo displays, Pass-N-Gas crates, construction
	     crates and toolboxes, liquor piles and beer coolers (luxuries), and air drops. Water bundles are found only in
	     Shamway crates (the user, 2026-10-10), which with Pop-N-Pills crates (medical) carry them more often.
	     A pile drops the bundle of its own size; the odds keep the units each container gave before the sizes (a
	     medium pile 5% x1 became 2.5% of a Medium, a large pile 8% x1.5 became 4% of a Large).
	     Every one of these groups is count="all": each entry rolls on its own, and an entry's prob is only
	     rolled when force_prob is set (LootContainer.SpawnAllItemsFromList) - without it the bundle would drop
	     from every container. Only items are appended into existing groups (no new group is referenced), so the
	     single-pass lootgroup ordering does not apply. The old one-size bundles drop nowhere any more; any still
	     around deposit as one unit. -->
	<append xpath="/lootcontainers/lootgroup[@name='groupFoodPileSmall']"><item name="scBundleFoodSmall" count="1" prob="0.03" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupFoodPileMed']"><item name="scBundleFoodMedium" count="1" prob="0.025" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupFoodPileLarge']"><item name="scBundleFoodLarge" count="1" prob="0.04" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupCupboard']"><item name="scBundleFoodSmall" count="1" prob="0.02" force_prob="true"/></append>
	<!-- Shamway crates (the grocery's crates): food and water bundles, more often than anywhere else; the only water in loot -->
	<append xpath="/lootcontainers/lootgroup[@name='groupShamwayCrate']">
		<item name="scBundleFoodSmall" count="1" prob="0.15" force_prob="true"/>
		<item name="scBundleFoodMedium" count="1" prob="0.05" force_prob="true"/>
		<item name="scBundleWaterSmall" count="1" prob="0.12" force_prob="true"/>
		<item name="scBundleWaterMedium" count="1" prob="0.04" force_prob="true"/>
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupMedicalPileSmall']"><item name="scBundleMedsSmall" count="1" prob="0.03" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupMedicalPileMed']"><item name="scBundleMedsMedium" count="1" prob="0.025" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupMedicalPileLarge']"><item name="scBundleMedsLarge" count="1" prob="0.04" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupMedicineCabinet']"><item name="scBundleMedsSmall" count="1" prob="0.03" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupCoolerMedical']"><item name="scBundleMedsSmall" count="1" prob="0.05" force_prob="true"/></append>
	<!-- Pop-N-Pills crates: the medical store's own stock, more often than anywhere else (was a Small at 6%) -->
	<append xpath="/lootcontainers/lootgroup[@name='groupPopNPillsCrate']">
		<item name="scBundleMedsSmall" count="1" prob="0.15" force_prob="true"/>
		<item name="scBundleMedsMedium" count="1" prob="0.05" force_prob="true"/>
	</append>

	<append xpath="/lootcontainers/lootgroup[@name='groupAmmoPileSmall']"><item name="scBundleAmmoSmall" count="1" prob="0.03" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupAmmoPileMed']"><item name="scBundleAmmoMedium" count="1" prob="0.025" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupAmmoPileLarge']"><item name="scBundleAmmoLarge" count="1" prob="0.04" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupMilitaryFootlocker']"><item name="scBundleAmmoSmall" count="1" prob="0.05" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupShotgunMessiahCrate']"><item name="scBundleAmmoSmall" count="1" prob="0.06" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupAmmoRackDisplay']"><item name="scBundleAmmoSmall" count="1" prob="0.04" force_prob="true"/></append>

	<append xpath="/lootcontainers/lootgroup[@name='groupLiquorPileSmall']"><item name="scBundleLuxurySmall" count="1" prob="0.03" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupLiquorPileMed']"><item name="scBundleLuxuryMedium" count="1" prob="0.025" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupLiquorPileLarge']"><item name="scBundleLuxuryLarge" count="1" prob="0.04" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupBeerCooler']"><item name="scBundleLuxurySmall" count="1" prob="0.03" force_prob="true"/></append>

	<append xpath="/lootcontainers/lootgroup[@name='groupPassNGas']"><item name="scBundleFuelSmall" count="1" prob="0.08" force_prob="true"/></append>

	<append xpath="/lootcontainers/lootgroup[@name='groupConstructionCrate']"><item name="scBundleMaterialsSmall" count="1" prob="0.06" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupToolbox']"><item name="scBundleMaterialsSmall" count="1" prob="0.03" force_prob="true"/></append>
	<append xpath="/lootcontainers/lootgroup[@name='groupRollingToolbox']"><item name="scBundleMaterialsSmall" count="1" prob="0.05" force_prob="true"/></append>

	<!-- air drops (the radio calls them in): each of the five classic resources rolls on its own, a Medium at 26%
	     (it was 1-2 bundles at 35%) -->
	<append xpath="/lootcontainers/lootgroup[@name='groupAirDrop']">
		<item name="scBundleFoodMedium" count="1" prob="0.26" force_prob="true"/>
		<item name="scBundleMedsMedium" count="1" prob="0.26" force_prob="true"/>
		<item name="scBundleAmmoMedium" count="1" prob="0.26" force_prob="true"/>
		<item name="scBundleMaterialsMedium" count="1" prob="0.26" force_prob="true"/>
		<item name="scBundleFuelMedium" count="1" prob="0.26" force_prob="true"/>
	</append>

	<!-- Trader quest rewards (quests.xml reward type="LootItem" picks ONE entry of the group, weighted by each
	     entry's loot_prob_template at the quest's tier - LootContainer.GetRewardItem). Food / medical / ammo use
	     the vanilla tier templates like their neighbours: a Small bundle from tier 1, a Medium from tier 2 on, a Large
	     at tier 3 (the 1 / 2 / 3 bundles they gave before); the resource rewards take a materials or a fuel bundle as
	     one more equal choice. -->
	<append xpath="/lootcontainers/lootgroup[@name='groupQuestFood']">
		<item name="scBundleFoodSmall" count="1" loot_prob_template="QuestT1Prob"/>
		<item name="scBundleFoodMedium" count="1" loot_prob_template="QuestT2Prob"/>
		<item name="scBundleFoodLarge" count="1" loot_prob_template="QuestT3Prob"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupQuestMedical']">
		<item name="scBundleMedsSmall" count="1" loot_prob_template="QuestT1Prob"/>
		<item name="scBundleMedsMedium" count="1" loot_prob_template="QuestT2Prob"/>
		<item name="scBundleMedsLarge" count="1" loot_prob_template="QuestT3Prob"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupQuestAmmo']">
		<item name="scBundleAmmoSmall" count="1" loot_prob_template="QuestT1Prob"/>
		<item name="scBundleAmmoMedium" count="1" loot_prob_template="QuestT2Prob"/>
		<item name="scBundleAmmoLarge" count="1" loot_prob_template="QuestT3Prob"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupQuestResourcesT0']">
		<item name="scBundleMaterialsSmall" count="1"/>
		<item name="scBundleFuelSmall" count="1"/>
	</append>
	<append xpath="/lootcontainers/lootgroup[@name='groupQuestResourcesT1']">
		<item name="scBundleMaterialsMedium" count="1"/>
		<item name="scBundleFuelMedium" count="1"/>
	</append>

	<!-- E9: the supply crates an Allied enclave drops when called on the radio (ScEncCalls; the crates are the entity
	     classes scEncDrop<Kind> in entityclasses.xml, whose LootList names these containers). A crate is the air drop's
	     own: 8x4, one roll, it breaks open when closed. Its roll is a count="all" group (every entry spawns; the piles'
	     own odds apply inside them): medium piles of what the kind makes - militia ammo, medics medicine, growers food
	     and water, builders building supplies, a road crew fuel and car parts, scavengers one pile of each - and one
	     Medium bundle of their resource for the stockpile (scavengers: one of the five classic ones). The groups are new,
	     so they are appended after every vanilla group they use, and each container after its group: the loot parser is
	     single-pass, in document order. -->
	<append xpath="/lootcontainers">
		<lootgroup name="groupScEncDropGrowers" count="all">
			<item group="groupFoodPileMed" count="3"/>
			<item name="drinkJarBoiledWater" count="4,8"/>
			<item name="scBundleFoodMedium" count="1"/>
		</lootgroup>
		<lootgroup name="groupScEncDropMedics" count="all">
			<item group="groupMedicalPileMed" count="3"/>
			<item name="scBundleMedsMedium" count="1"/>
		</lootgroup>
		<lootgroup name="groupScEncDropMilitia" count="all">
			<item group="groupAmmoPileMed" count="3"/>
			<item name="scBundleAmmoMedium" count="1"/>
		</lootgroup>
		<lootgroup name="groupScEncDropBuilders" count="all">
			<item group="groupConstructionCrate" count="2"/>
			<item name="scBundleMaterialsMedium" count="1"/>
		</lootgroup>
		<lootgroup name="groupScEncDropRoadcrew" count="all">
			<item group="groupPassNGas" count="2"/>
			<item name="scBundleFuelMedium" count="1"/>
		</lootgroup>
		<!-- a scavengers' bundle: one of the five, weighted alike -->
		<lootgroup name="groupScEncDropGeneralBundle">
			<item name="scBundleFoodMedium" count="1"/>
			<item name="scBundleMedsMedium" count="1"/>
			<item name="scBundleAmmoMedium" count="1"/>
			<item name="scBundleMaterialsMedium" count="1"/>
			<item name="scBundleFuelMedium" count="1"/>
		</lootgroup>
		<lootgroup name="groupScEncDropGeneral" count="all">
			<item group="groupFoodPileMed" count="1"/>
			<item group="groupMedicalPileMed" count="1"/>
			<item group="groupAmmoPileMed" count="1"/>
			<item group="groupConstructionCrate" count="1"/>
			<item group="groupPassNGas" count="1"/>
			<item group="groupScEncDropGeneralBundle" count="1"/>
		</lootgroup>
		<lootcontainer name="scEncDropGrowers" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="groupScEncDropGrowers"/>
		</lootcontainer>
		<lootcontainer name="scEncDropMedics" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="groupScEncDropMedics"/>
		</lootcontainer>
		<lootcontainer name="scEncDropMilitia" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="groupScEncDropMilitia"/>
		</lootcontainer>
		<lootcontainer name="scEncDropBuilders" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="groupScEncDropBuilders"/>
		</lootcontainer>
		<lootcontainer name="scEncDropRoadcrew" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="groupScEncDropRoadcrew"/>
		</lootcontainer>
		<lootcontainer name="scEncDropGeneral" count="1" size="8,4" destroy_on_close="true" sound_open="SupplyDrops/open_supply_crate" sound_close="SupplyDrops/close_supply_crate" loot_quality_template="qualBaseTemplate">
			<item group="groupScEncDropGeneral"/>
		</lootcontainer>
	</append>
</configs>
