<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!-- Enclave leaders' stock (E3, Enclaves_Plan.md 2.7; ScEnclaveDeals). The leader of an enclave that is not hostile is a
	     real trader: their body's TraderData names one of these by the enclave's kind - EnclaveTraderIdBase (200) + 0..5:
	     general, growers, medics, militia, builders, roadcrew (keep the ids and EnclaveTraderIdBase in step). Each enclave
	     keeps its own stock and restock clock in its record, so one entry per kind serves them all.
	     - Smaller than a vanilla trader's stock (an enclave is not a store), drawn only from vanilla's own item groups (and
	       one gas can entry): TradersFromXml throws on a group or an item it does not know, which would stop every trader.
	     - reset_interval as vanilla's (3 days): vanilla restocks at the first trade after that.
	     - No open_time / close_time: UseOpenHours stays off, so anything that reads trader hours reads them as open (SCore's
	       V4 body never checks them on activation).
	     - Traps: allow_buy writes AllowSell (not used here); a duplicate id throws (vanilla uses 1-10, XNPCCore's 60-63 are
	       commented out); the list has 256 slots; no override markups, so the player's barter perks still apply. -->
	<!-- R2 (round 27): traders stock a handheld radio now and then - vanilla's traderElectrical group, which every trader
	     (and the builders' enclave stock below) draws a handful of unique entries from; prob 0.35 within that. The item must
	     load first (Config/items.xml): TradersFromXml throws on an item it does not know. -->
	<append xpath="/traders/trader_item_groups/trader_item_group[@name='traderElectrical']">
		<item name="scHandheldRadio" count="1" prob="0.35"/>
	</append>
	<append xpath="/traders">
		<!-- 200 general: a bit of everything a scavenging group finds -->
		<trader_info id="200" reset_interval="3">
			<trader_items count="all">
				<item group="traderGeneral" count="3,5"/>
				<item group="groupFoodAll" count="1,2"/>
				<item group="medicine" count="1,2"/>
				<item group="generalResources" count="2,4"/>
				<item group="ammoBrass" count="1"/>
				<item group="tools" unique_only="true" count="1,2"/>
				<item group="groupMeleeAll" count="1"/>
			</trader_items>
		</trader_info>
		<!-- 201 growers (farms): food and seeds -->
		<trader_info id="201" reset_interval="3">
			<trader_items count="all">
				<item group="seeds" unique_only="true" count="3,5"/>
				<item group="foodSupplies" count="3,5"/>
				<item group="cannedfood" count="2,3"/>
				<item group="preparedFood" count="1,3"/>
				<item group="groupDrinks" count="1,2"/>
			</trader_items>
		</trader_info>
		<!-- 202 medics (clinics): medicine -->
		<trader_info id="202" reset_interval="3">
			<trader_items count="all">
				<item group="medicine" count="4,6"/>
				<item group="rareMedicine" count="1,2"/>
				<item group="foodCandy" unique_only="true" count="1,2"/>
				<item group="groupDrinks" count="1"/>
			</trader_items>
		</trader_info>
		<!-- 203 militia (military, police, gun stores): guns and ammo -->
		<trader_info id="203" reset_interval="3">
			<trader_items count="all">
				<item group="groupRangedAll" unique_only="true" count="2,3"/>
				<item group="groupMeleeAll" unique_only="true" count="1,2"/>
				<item group="ammoBrass" count="2,3"/>
				<item group="ammoHP" count="1"/>
				<item group="ammoArrowsBolts" count="1,2"/>
				<item group="weaponsGunParts" count="1,2"/>
				<item group="thrownAmmo" count="1"/>
			</trader_items>
		</trader_info>
		<!-- 204 builders (industry, hardware): tools and materials -->
		<trader_info id="204" reset_interval="3">
			<trader_items count="all">
				<item group="tools" unique_only="true" count="2,3"/>
				<item group="rareTools" count="1"/>
				<item group="constructionSupplies" count="2,3"/>
				<item group="generalResources" count="3,5"/>
				<item group="traderElectrical" count="1"/>
			</trader_items>
		</trader_info>
		<!-- 205 road crew (gas stations, refineries): fuel and vehicle parts -->
		<trader_info id="205" reset_interval="3">
			<trader_items count="all">
				<item name="ammoGasCan" count="500,1500"/>
				<item group="groupVehicles" count="1"/>
				<item group="groupVehicleMods" unique_only="true" count="1,2"/>
				<item group="generalResources" count="2,3"/>
				<item group="tools" unique_only="true" count="1"/>
			</trader_items>
		</trader_info>
	</append>
</configs>
