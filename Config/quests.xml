<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!--
	  The recruit favour "secure this POI". DELIBERATELY no RallyPoint objective: ObjectiveRallyPoint is the
	  only vanilla path to QuestEventManager.QuestLockPOI -> World.ResetPOIS, which restores the POI's blocks
	  from the prefab and respawns every sleeper. ClearSleepers alone gives the sleeper-volume map markers and
	  the tracker line. Phase 2 is "return to the survivor": vanilla InteractWithNPC completes on the
	  NPC-interacted event when the player opens the dialog of the quest giver (Quest.QuestGiverID = the
	  survivor; return_to_quest_giver defaults to true). completiontype AutoComplete: the quest completes on
	  that talk, no turn-in window; add_to_tier_complete false: no trader tier progression. The favour
	  completes only through this quest: a POI that already reads clear when the player marks it is
	  completed from the dialog ("Actually, I've already cleared that."), which closes the quest.

	  Do NOT add a Goto / RandomPOIGoto objective: the mod pre-seeds DataVariables["POIName"] and those
	  objectives do an unguarded DataVariables.Add("POIName", ...).
	-->
	<append xpath="/quests">
		<quest id="quest_scSecurePoi">
			<property name="name_key" value="scQuestSecureName"/>
			<property name="subtitle_key" value="scQuestSecureSubtitle"/>
			<property name="description_key" value="scQuestSecureDesc"/>
			<property name="icon" value="ui_game_symbol_zombie"/>
			<property name="category_key" value="quest"/>
			<property name="offer_key" value="scQuestSecureOffer"/>
			<property name="repeatable" value="true"/>
			<property name="shareable" value="false"/>
			<property name="completiontype" value="AutoComplete"/>
			<property name="completion_key" value="scQuestSecureCompletion"/>
			<property name="add_to_tier_complete" value="false"/>
			<property name="allow_remove" value="true"/>

			<objective type="ClearSleepers">
				<property name="phase" value="1"/>
				<property name="nav_object" value="sleeper_volume"/>
			</objective>
			<objective type="ScTalkToSurvivor, SurvivorCommunity">
				<property name="phase" value="2"/>
			</objective>
		</quest>

		<!-- The supplies favour ("Sure, I'll see what I can find."): one objective that never completes on its own -
		     the hand-over in the survivor's dialog closes the quest (Completed); death or a skipped favour removes it.
		     The marker is the mod's own, on the survivor. -->
		<quest id="quest_scSupplies">
			<property name="name_key" value="scQuestSuppliesName"/>
			<property name="subtitle_key" value="scQuestSecureSubtitle"/>
			<property name="description_key" value="scQuestSuppliesDesc"/>
			<property name="icon" value="ui_game_symbol_loot_sack"/>
			<property name="category_key" value="quest"/>
			<property name="offer_key" value="scQuestSuppliesOffer"/>
			<property name="repeatable" value="true"/>
			<property name="shareable" value="false"/>
			<property name="completiontype" value="AutoComplete"/>
			<property name="completion_key" value="scQuestSuppliesCompletion"/>
			<property name="add_to_tier_complete" value="false"/>
			<property name="allow_remove" value="true"/>
			<objective type="ScBringSupplies, SurvivorCommunity">
				<property name="phase" value="1"/>
			</objective>
		</quest>

		<!-- The radio rescue: a survivor on a supply run is pinned at a POI. The objective never completes on its
		     own - the mod closes the quest when the zombies it spawned around the survivor are all down (Completed)
		     or when the run ends unanswered / the survivor falls (removed). No location objective on purpose (see
		     above); the marker is the mod's own. -->
		<quest id="quest_scRescue">
			<property name="name_key" value="scQuestRescueName"/>
			<property name="subtitle_key" value="scQuestRescueSubtitle"/>
			<property name="description_key" value="scQuestRescueDesc"/>
			<property name="icon" value="ui_game_symbol_zombie"/>
			<property name="category_key" value="quest"/>
			<property name="offer_key" value="scQuestRescueOffer"/>
			<property name="repeatable" value="true"/>
			<property name="shareable" value="false"/>
			<property name="completiontype" value="AutoComplete"/>
			<property name="completion_key" value="scQuestRescueCompletion"/>
			<property name="add_to_tier_complete" value="false"/>
			<property name="allow_remove" value="true"/>
			<objective type="ScRescue, SurvivorCommunity">
				<property name="phase" value="1"/>
			</objective>
		</quest>

		<!-- E4, an enclave's request taken on ("Leave it with me."): "Help <enclave>", one display-only objective (what,
		     to whom, by the end of which day) that never completes on its own - the hand-over in the leader's talk closes
		     it (Completed); giving it up, running out of time or the enclave turning hostile or falling removes it
		     (failed). The registry's request is the authority, so the player cannot remove it from the journal
		     (allow_remove false: they tell the leader "I can't do it."). The marker is the mod's own, on the enclave's
		     building (POIPosition/POISize). No InteractWithNPC: the giver is the enclave, not a body. -->
		<quest id="quest_scEncRequest">
			<property name="name_key" value="scQuestEncReqName"/>
			<property name="subtitle_key" value="scQuestEncReqSubtitle"/>
			<property name="description_key" value="scQuestEncReqDesc"/>
			<property name="icon" value="ui_game_symbol_loot_sack"/>
			<property name="category_key" value="quest"/>
			<property name="offer_key" value="scQuestEncReqOffer"/>
			<property name="repeatable" value="true"/>
			<property name="shareable" value="false"/>
			<property name="completiontype" value="AutoComplete"/>
			<property name="completion_key" value="scQuestEncReqCompletion"/>
			<property name="add_to_tier_complete" value="false"/>
			<property name="allow_remove" value="false"/>
			<objective type="ScEncRequest, SurvivorCommunity">
				<property name="phase" value="1"/>
			</objective>
		</quest>

		<!-- E5, a missing survivor's search ("Leave it with me."): "Find <name>". Phase 1, display only, "Find <name>, last seen
		     at <POI>, by the end of day <n>" (once they follow the player, "Bring <name> home to <enclave>"), its marker on the
		     building searched, then on the enclave; phase 2, "Tell <enclave> about <name>", only once their remains were
		     searched (the mod moves the phase: its objectives never complete on their own). The search closes it: home safe or
		     the leader told (Completed), never found or dead on the way (removed as failed). No ClearSleepers, Goto or
		     RallyPoint, no InteractWithNPC: as quest_scEncRequest. -->
		<quest id="quest_scEncSearch">
			<property name="name_key" value="scQuestEncSearchName"/>
			<property name="subtitle_key" value="scQuestEncSearchSubtitle"/>
			<property name="description_key" value="scQuestEncSearchDesc"/>
			<property name="icon" value="ui_game_symbol_search"/>
			<property name="category_key" value="quest"/>
			<property name="offer_key" value="scQuestEncSearchOffer"/>
			<property name="repeatable" value="true"/>
			<property name="shareable" value="false"/>
			<property name="completiontype" value="AutoComplete"/>
			<property name="completion_key" value="scQuestEncSearchCompletion"/>
			<property name="add_to_tier_complete" value="false"/>
			<property name="allow_remove" value="false"/>
			<objective type="ScEncSearch, SurvivorCommunity">
				<property name="phase" value="1"/>
			</objective>
			<objective type="ScEncReturn, SurvivorCommunity">
				<property name="phase" value="2"/>
			</objective>
		</quest>

		<!-- E5, an infestation to clear: "Clear <POI>", one display-only objective, its marker on the infested building. I1's
		     own "cleared" path closes it (Completed); never a ClearSleepers objective - it would re-arm the rooms. -->
		<quest id="quest_scEncInfest">
			<property name="name_key" value="scQuestEncInfestName"/>
			<property name="subtitle_key" value="scQuestEncInfestSubtitle"/>
			<property name="description_key" value="scQuestEncInfestDesc"/>
			<property name="icon" value="ui_game_symbol_zombie"/>
			<property name="category_key" value="quest"/>
			<property name="offer_key" value="scQuestEncInfestOffer"/>
			<property name="repeatable" value="true"/>
			<property name="shareable" value="false"/>
			<property name="completiontype" value="AutoComplete"/>
			<property name="completion_key" value="scQuestEncInfestCompletion"/>
			<property name="add_to_tier_complete" value="false"/>
			<property name="allow_remove" value="false"/>
			<objective type="ScEncInfest, SurvivorCommunity">
				<property name="phase" value="1"/>
			</objective>
		</quest>

		<!-- E5, a siege (the radio's call): "Siege at <enclave>", one display-only objective counting down live ("mm:ss to
		     reach <enclave>", then "<n> left": ObjectiveScEncSiege reads the registry's world-time deadline), its marker on the
		     enclave's building, tracked at the call. Won or held (Completed), lost (removed as failed). -->
		<quest id="quest_scEncSiege">
			<property name="name_key" value="scQuestEncSiegeName"/>
			<property name="subtitle_key" value="scQuestEncSiegeSubtitle"/>
			<property name="description_key" value="scQuestEncSiegeDesc"/>
			<property name="icon" value="ui_game_symbol_zombie"/>
			<property name="category_key" value="quest"/>
			<property name="offer_key" value="scQuestEncSiegeOffer"/>
			<property name="repeatable" value="true"/>
			<property name="shareable" value="false"/>
			<property name="completiontype" value="AutoComplete"/>
			<property name="completion_key" value="scQuestEncSiegeCompletion"/>
			<property name="add_to_tier_complete" value="false"/>
			<property name="allow_remove" value="false"/>
			<objective type="ScEncSiege, SurvivorCommunity">
				<property name="phase" value="1"/>
			</objective>
		</quest>
	</append>
</configs>
