<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!--
	  Resident behaviour, added to a member's AIPackages at RUNTIME by the mod (the list is rebuilt from the
	  entity class on every load, so it is re-added by the ticker). XNPCCore's utilityai.xml removes and
	  rebuilds /utility_ai/ai_packages, so this mod must load after it (folder name sorts after "0-").

	  A resident holds the Guard order (CurrentOrder 9): NPCModCore's Guard action walks them back to their
	  post and the combat packages (which only gate on NotHasOrder Stay) still fight anything that comes
	  close. These two actions add a daytime roam around the post and a quiet night.

	  The roam, the leash and the quiet night are gated on ScIsResident (stationed at home), not merely on
	  membership: they work from the member's HOME post, and a FOLLOWER can hold the very same order 9 -
	  0-XNPCCore's "guard and return" voice order is buffOrderGuard. Such a follower guards where the player
	  said (NPCModCore's Guard) instead of being leashed back home from 500 m out.
	-->
	<append xpath="/utility_ai/ai_packages">
		<ai_package name="SCResident">
			<!-- ScRoamReady stays true while the roam runs and false for "cooldown" real seconds after it
			     stops; the AI re-scores every 0.2 s, so a cooldown consumed during scoring would end every
			     roam after one decision window. -->
			<action name="ScRoam" weight="2.5" entity_filter="IsSelf">
				<task class="WanderHomeSC, SurvivorCommunity" radius="12" cooldown="45" />
				<consideration class="ScIsResident, SurvivorCommunity" />
				<consideration class="HasOrder, SCore" order="Guard" />
				<consideration class="EnemyNotNear, SCore" distance="30" />
				<consideration class="ScIsDaytime, SurvivorCommunity" />
				<consideration class="ScRoamReady, SurvivorCommunity" />
			</action>
			<!-- The leash. The pack's combat actions (weight 4-6) only stand down under a Stay order, so a
			     resident on Guard chases a zombie as far as it runs - playtest logs showed one 92 m from home.
			     This outscores the chase (but not point-blank self defence at weight 6) once they are further
			     from their post than ScConfig-independent "distance", walking them home with SCore's Guard task. -->
			<action name="ScReturn" weight="5.5" entity_filter="IsSelf">
				<task class="Guard, SCore" />
				<consideration class="ScIsResident, SurvivorCommunity" />
				<consideration class="HasOrder, SCore" order="Guard" />
				<consideration class="ScFarFromPost, SurvivorCommunity" distance="25" />
			</action>
			<!-- A physical supply runner (ScRunners) holds the Task order (8), which nothing else in SCore or XNPCCore
			     uses: every resident action above stands down, the pack's combat still fires (it only gates on NotHasOrder
			     Stay), and this walks them along their route one waypoint at a time. 4.5 beats the chase (4) and idling,
			     and loses to in-range attacks (5-6), so a runner fights what reaches them and then walks on. -->
			<action name="ScTravel" weight="4.5" entity_filter="IsSelf">
				<task class="TravelSC, SurvivorCommunity" />
				<consideration class="ScIsMember, SurvivorCommunity" />
				<consideration class="HasOrder, SCore" order="Task" />
				<consideration class="ScTravelling, SurvivorCommunity" />
			</action>
			<!-- Following belongs to 0-XNPCCore: its DynamicFollow (NPCModNPCHired, weight 2) with Voice Control's
			     formations, follow distances and stances replaces the community's own follow (decision D6), and the
			     ticker reads every voice order as a member state. These two are only the FALLBACK for a member whose
			     packages have no DynamicFollow (ScNoDynamicFollow - a pack NPC from another mod): at 4 and 4.2 they
			     would outrank DynamicFollow and fight it. They were written for 3.1's pack, whose LeaderFollowSlow
			     (2) and TooCloseInside/Outside (3) made a follower orbit the player around 2.5 m: these walk the NPC
			     in to 3 m and let it stand. Combat (weight 4-6) still takes precedence. -->
			<action name="ScFollowLeader" weight="4" entity_filter="IsLeader">
				<task class="FollowSDX, SCore" stop_distance="3" max_distance="25" teleport_time="5" />
				<consideration class="ScIsMember, SurvivorCommunity" />
				<consideration class="ScNoDynamicFollow, SurvivorCommunity" />
				<consideration class="HasOrder, SCore" order="Follow" />
				<consideration class="TargetDistance" min="3" max="30" curve="threshold" />
			</action>
			<action name="ScHoldWithLeader" weight="4.2" entity_filter="IsLeader">
				<task class="IdleSDX, SCore" />
				<consideration class="ScIsMember, SurvivorCommunity" />
				<consideration class="ScNoDynamicFollow, SurvivorCommunity" />
				<consideration class="HasOrder, SCore" order="Follow" />
				<consideration class="EnemyNotNear, SCore" distance="20" />
				<consideration class="TargetDistance" flip_x="true" min="0" max="3" curve="threshold" />
			</action>
			<!-- only once they are back at the post: until then NPCModCore's Guard (weight 2) walks them home -->
			<action name="ScNightIdle" weight="3" entity_filter="IsSelf">
				<task class="IdleSDX, SCore" />
				<consideration class="ScIsResident, SurvivorCommunity" />
				<consideration class="HasOrder, SCore" order="Guard" />
				<consideration class="EnemyNotNear, SCore" distance="30" />
				<consideration class="ScIsNight, SurvivorCommunity" />
				<consideration class="ScNearPost, SurvivorCommunity" distance="4" />
			</action>
			<!-- Cowardly members ($Timid, written by ScTraits) run from enemies within 15 m. Up to 0-XNPCCore 3.1 its
			     NPCModCore had this very action; 3.2 commented it out ("$Timid has no writer" - this mod is one), so it
			     lives here now. NotHasOrder Stay keeps a parked, hidden runner or garrison body still. Under 3.1 both
			     run at the same weight, which is harmless. -->
			<action name="ScFlee" weight="6" entity_filter="IsEnemy">
				<task class="FleeFromTarget" max_distance="30" />
				<consideration class="SelfHasCVar, SCore" cvar="$Timid" value="1" />
				<consideration class="NotHasOrder, SCore" order="Stay" />
				<consideration class="TargetDistance" min="0" max="15" curve="threshold" />
				<consideration class="SelfVisible" />
			</action>
		</ai_package>
	</append>
</configs>
