<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!--
	  Recruiting is injected into EVERY dialog that has a "Hire" response (XNPCCore's GenericNPC,
	  GenericNPCAnimal, GenericNPCNurse and any character pack that copies that shape), so installed NPC
	  packs join the pool without being listed here. The custom operators live in SurvivorCommunity.dll:
	  type="ScFavour, SurvivorCommunity" resolves to the global class DialogRequirementScFavour.

	  Flow (only once the player has a community home):
	         start -> "I could use someone like you in my community"   (scJoinPoi | scJoinSupplies)
	         -> favour statement (secure the nearest POI / bring N items)
	         POI:      "Mark it" (journal quest; ends the talk) ... scPoiDone (join)
	                   or, when the POI already reads clear, "Mark it" -> scPoiMarked -> scPoiAlreadyCleared
	                   -> scPoiClearedReply (join)
	         supplies: scAcceptSupplies "Sure, I'll see what I can find." (journal quest) ... scGiveSupplies (take + join),
	                   or scGiveSuppliesNow in the same talk when the items are already carried;
	                   scSuppliesDone (join) if the join was refused after the hand-over
	  A favour completes only through itself: the quest's clearing (or "Actually, I've already cleared that."), or the
	  supplies handed over.
	  Members get "Community" (opens the roster) and lose the vanilla Hire entry.
	-->

	<!-- menu entries, after the Hire entry in every statement that lists it -->
	<insertAfter xpath="/dialogs/dialog[response[@id='Hire']]/statement/response_entry[@id='Hire']">
		<response_entry id="scJoinPoi" />
		<response_entry id="scJoinSupplies" />
		<response_entry id="scPoiDone" />
		<response_entry id="scGiveSupplies" />
		<response_entry id="scSuppliesDone" />
		<response_entry id="scCommunity" />
		<response_entry id="scFollow" />
		<response_entry id="scGoHome" />
		<response_entry id="scRun" />
		<response_entry id="scRunHeadHome" />
		<response_entry id="scLeave" />
	</insertAfter>

	<!-- Members are managed from the community roster: the vanilla hire / order / dismiss / pick-up
	     entries disappear on them (a vanilla Dismiss or Follow on a member would fight the community's
	     own stationing). Weapon swaps and "show me your inventory" stay. 0-XNPCCore 3.2's route recording
	     (SetPatrolPoint "Show me a route", CancelPatrolRecord) is hidden too. Since migration M2 the ticker keeps a
	     follower's voice / order-wheel orders (stay, guard, wander, a route) as member states, so these command rows
	     COULD be offered to followers; they stay hidden until the user decides (the order wheel and "@name" commands
	     already give the same orders). -->
	<append xpath="/dialogs/dialog/response[@id='Hire' or @id='Dismiss' or @id='FollowMe' or @id='StayHere' or @id='GuardHere' or @id='GuardReturnHere' or @id='Wander' or @id='Patrol' or @id='Loot' or @id='SetCode' or @id='Pickup' or @id='SetPatrolPoint' or @id='CancelPatrolRecord']">
		<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" operator="not" />
		<!-- an outpost / distress stand-in is that member too: nobody hires, orders or picks it up -->
		<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_standin" operator="not" />
		<!-- one of an enclave's people neither (E2): they start at their own statements (the phases below), this is for a
		     talk that ever reaches "start" all the same (a multiplayer client, where the phases' requirements are host-only) -->
		<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="%sc_enc" operator="not" />
	</append>
	<append xpath="/dialogs/dialog/response[@id='ShowMe']">
		<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="%sc_enc" operator="not" />
	</append>

	<append xpath="/dialogs/dialog[response[@id='Hire']]">
		<!-- ask to join: one of the two shows, depending on the favour rolled for this NPC. Who may be asked is
		     ScCanRecruit's call: since migration M2 (decision D9) that includes a companion YOU hired the vanilla way -
		     joining ends the paid hire - but never somebody else's hire. Nothing is offered (or rolled: requirements stop
		     at the first that fails) before the player has a community home. -->
		<response id="scJoinPoi" text="scJoinPoi" nextstatementid="scFavourPoi">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="poi" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<action type="ScFavourBrief, SurvivorCommunity" />
		</response>
		<response id="scJoinSupplies" text="scJoinSupplies" nextstatementid="scFavourSupplies">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<action type="ScFavourBrief, SurvivorCommunity" />
		</response>

		<statement id="scFavourPoi" text="scFavourPoi_text">
			<response_entry id="scStartPoi" />
			<response_entry id="scStartPoiCleared" />
			<response_entry id="done" />
		</statement>
		<statement id="scFavourSupplies" text="scFavourSupplies_text">
			<response_entry id="scGiveSuppliesNow" />
			<response_entry id="scAcceptSupplies" />
			<response_entry id="done" />
		</statement>

		<!-- POI favour. "Mark it" puts the quest in the journal. Two of them, one shown: when the POI does not read clear
		     it just ends the talk; when it already does (the test vanilla's quest uses), the survivor answers and the
		     player can say so - that completes the favour and closes the quest. -->
		<response id="scStartPoi" text="scStartPoi">
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScFavourPoiCleared, SurvivorCommunity" requirementtype="Hide" value="not" />
			<action type="ScStartPoiQuest, SurvivorCommunity" />
		</response>
		<response id="scStartPoiCleared" text="scStartPoi" nextstatementid="scPoiMarked">
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScFavourPoiCleared, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScStartPoiQuest, SurvivorCommunity" />
		</response>
		<statement id="scPoiMarked" text="scPoiMarked_text">
			<response_entry id="scPoiAlreadyCleared" />
			<response_entry id="scPoiOnIt" />
		</statement>
		<response id="scPoiOnIt" text="scPoiOnIt" />
		<response id="scPoiAlreadyCleared" text="scPoiAlreadyCleared" nextstatementid="scPoiClearedReply">
			<requirement type="ScFavourPoiCleared, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScFavourPoiCleared, SurvivorCommunity" />
		</response>
		<statement id="scPoiClearedReply" text="scPoiClearedReply_text">
			<response_entry id="scPoiClearedJoin" />
			<response_entry id="scPoiLater" />
		</statement>
		<response id="scPoiLater" text="scPoiLater" />
		<response id="scPoiClearedJoin" text="scPoiClearedJoin">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>
		<!-- shown at the root once the favour is done (the quest's clearing, or "Actually, I've already cleared that.") -->
		<response id="scPoiDone" text="scPoiDone">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="poi" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>

		<!-- supplies favour. "Sure, I'll see what I can find." takes it on (journal quest, marker on the survivor; ends
		     the talk). The hand-over: at the root while the items are carried, once taken on (scGiveSupplies), or in the
		     answer itself when they are carried already (scGiveSuppliesNow). -->
		<response id="scAcceptSupplies" text="scAcceptSupplies">
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScFavourQuestOpen, SurvivorCommunity" requirementtype="Hide" value="not" />
			<action type="ScStartSuppliesQuest, SurvivorCommunity" />
		</response>
		<!-- shown at the root if the join was refused after the supplies were handed over -->
		<response id="scSuppliesDone" text="scSuppliesDone">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>
		<response id="scGiveSupplies" text="scGiveSupplies">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScHasFavourItems, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScTakeFavourItems, SurvivorCommunity" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>
		<response id="scGiveSuppliesNow" text="scGiveSupplies">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScHasFavourItems, SurvivorCommunity" requirementtype="Hide" value="any" />
			<action type="ScTakeFavourItems, SurvivorCommunity" value="any" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>

		<!-- members: open the roster, and the three orders (the vanilla hire / dismiss entries are hidden on them) -->
		<response id="scCommunity" text="scCommunity">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
			<action type="ScOpenCommunity, SurvivorCommunity" />
		</response>
		<response id="scFollow" text="scFollow">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_following" operator="not" />
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_onrun" operator="not" />
			<action type="ScFollow, SurvivorCommunity" />
		</response>
		<response id="scGoHome" text="scGoHome">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_following" value="1" />
			<action type="ScGoHome, SurvivorCommunity" />
		</response>
		<response id="scRun" text="scRun" nextstatementid="scRunPick">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_onrun" operator="not" />
		</response>
		<!-- a runner met out in the world: turn round -->
		<response id="scRunHeadHome" text="scRunHeadHome">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_onrun" value="1" />
			<action type="ScRecall, SurvivorCommunity" />
		</response>
		<statement id="scRunPick" text="scRunPick_text">
			<response_entry id="scRunFood" />
			<response_entry id="scRunWater" />
			<response_entry id="scRunMeds" />
			<response_entry id="scRunAmmo" />
			<response_entry id="scRunMaterials" />
			<response_entry id="scRunFuel" />
			<response_entry id="done" />
		</statement>
		<response id="scRunFood" text="scRunFood"><action type="ScRun, SurvivorCommunity" value="food" /></response>
		<response id="scRunWater" text="scRunWater"><action type="ScRun, SurvivorCommunity" value="water" /></response>
		<response id="scRunMeds" text="scRunMeds"><action type="ScRun, SurvivorCommunity" value="meds" /></response>
		<response id="scRunAmmo" text="scRunAmmo"><action type="ScRun, SurvivorCommunity" value="ammo" /></response>
		<response id="scRunMaterials" text="scRunMaterials"><action type="ScRun, SurvivorCommunity" value="mats" /></response>
		<response id="scRunFuel" text="scRunFuel"><action type="ScRun, SurvivorCommunity" value="fuel" /></response>
		<response id="scLeave" text="scLeave" nextstatementid="scLeaveConfirm">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
		</response>
		<statement id="scLeaveConfirm" text="scLeaveConfirm_text">
			<response_entry id="scLeaveYes" />
			<response_entry id="done" />
		</statement>
		<response id="scLeaveYes" text="scLeaveYes">
			<action type="ScLeave, SurvivorCommunity" />
		</response>
	</append>

	<!-- The weapon menu (0-XNPCCore's "Weapon Classes", shown to the NPC's leader) lists vanilla weapons only, so a gun from
	     a weapon pack (IZY Classic) handed over through the inventory window had no "Use" line. This one takes the best
	     gun or bow and the best melee weapon from the window that the survivors can carry (XnpcWeapons) into the pair and
	     the hand, the replaced ones coming back to you (ScArms.UseHanded). Hidden when there is none. ONE line: the
	     dialog shows ten responses at most and 0-XNPCCore's weapon menu has nine. -->
	<insertBefore xpath="/dialogs/dialog/statement[@id='Weapon Classes']/response_entry[1]">
		<response_entry id="scUseHanded" />
	</insertBefore>
	<append xpath="/dialogs/dialog[statement[@id='Weapon Classes']]">
		<response id="scUseHanded" text="scUseHanded">
			<requirement type="ScHandedWeapon, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScUseHanded, SurvivorCommunity" />
		</response>
	</append>

	<!-- Enclave people (E2, Enclaves_Plan.md 2.6; ScEnclavePeople, DialogOpsEnclaves.cs). Every player-body survivor talks
	     through 0-XNPCCore's SdcsNPC dialog; these phases pick its first statement for an enclave's people - the first phase
	     whose requirements all pass wins (Dialog.GetFirstStatment; no other dialog in the game or the installed mods has
	     phases, and none replaces the first statement). The leader and the members each have a greeting by standing: wary
	     at Neutral, warm at Friendly, welcoming at Allied. Anyone else falls through to XNPC's "start", and enclave people
	     never reach the stranger rows (Hire, the order menus, Pickup, ShowMe, SC's recruit and favour rows): those are hidden
	     on them besides (%sc_enc, above). A hostile enclave matches no phase, but X9 keeps its people from being talked to.
	     Requirements and the tokens the line panel fills ({enc}, {count}, {poi}, {leader}, {where}: XUiC_ScDialogLine,
	     ScEncDialog.Fill) are host-only. A line that will be voiced later says nothing that needs a name or a number: those
	     sit in a sentence of their own. Rows: the leader 4 with E3's trade (8 once E4's requests come), members 6 entries with
	     E3's enlist and the three recruit variants (4 at most on screen: hidden rows take no row), under the dialog's 10.
	     Never list Hire in these statements: SC's injection keys on it. -->
	<append xpath="/dialogs/dialog[@id='SdcsNPC']">
		<phase id="scEncLeaderAllied" startstatementid="scEncLeaderAllied">
			<requirement type="ScEncRole, SurvivorCommunity" value="leader" />
			<requirement type="ScEncStanding, SurvivorCommunity" value="allied" />
		</phase>
		<phase id="scEncLeaderFriendly" startstatementid="scEncLeaderFriendly">
			<requirement type="ScEncRole, SurvivorCommunity" value="leader" />
			<requirement type="ScEncStanding, SurvivorCommunity" value="friendly" />
		</phase>
		<phase id="scEncLeaderNeutral" startstatementid="scEncLeaderNeutral">
			<requirement type="ScEncRole, SurvivorCommunity" value="leader" />
			<requirement type="ScEncStanding, SurvivorCommunity" value="neutral" />
		</phase>
		<phase id="scEncMemberAllied" startstatementid="scEncMemberAllied">
			<requirement type="ScEncRole, SurvivorCommunity" value="member" />
			<requirement type="ScEncStanding, SurvivorCommunity" value="allied" />
		</phase>
		<phase id="scEncMemberFriendly" startstatementid="scEncMemberFriendly">
			<requirement type="ScEncRole, SurvivorCommunity" value="member" />
			<requirement type="ScEncStanding, SurvivorCommunity" value="friendly" />
		</phase>
		<phase id="scEncMemberNeutral" startstatementid="scEncMemberNeutral">
			<requirement type="ScEncRole, SurvivorCommunity" value="member" />
			<requirement type="ScEncStanding, SurvivorCommunity" value="neutral" />
		</phase>

		<!-- the leader's greetings (E3: "Let's trade." first) -->
		<statement id="scEncLeaderNeutral" text="scEncLeaderNeutral_text">
			<response_entry id="scEncTrade" />
			<response_entry id="scEncAbout" />
			<response_entry id="scEncThreat" />
			<response_entry id="done" />
		</statement>
		<statement id="scEncLeaderFriendly" text="scEncLeaderFriendly_text">
			<response_entry id="scEncTrade" />
			<response_entry id="scEncAbout" />
			<response_entry id="scEncThreat" />
			<response_entry id="done" />
		</statement>
		<statement id="scEncLeaderAllied" text="scEncLeaderAllied_text">
			<response_entry id="scEncTrade" />
			<response_entry id="scEncAbout" />
			<response_entry id="scEncThreat" />
			<response_entry id="done" />
		</statement>
		<!-- "Tell me about this place." -->
		<statement id="scEncAboutReply" text="scEncAboutReply_text">
			<response_entry id="scEncLeaderBackNeutral" />
			<response_entry id="scEncLeaderBackFriendly" />
			<response_entry id="scEncLeaderBackAllied" />
			<response_entry id="done" />
		</statement>
		<!-- "Hand over your supplies." (Q6 a): a confirm step; "I'm not asking." pays out and turns them hostile for good,
		     after EnclaveThreatGrace seconds so this closing is not a shot in the back; "Forget it." goes back to the greeting -->
		<statement id="scEncThreatConfirm" text="scEncThreatConfirm_text">
			<response_entry id="scEncThreatYes" />
			<response_entry id="scEncForgetNeutral" />
			<response_entry id="scEncForgetFriendly" />
			<response_entry id="scEncForgetAllied" />
		</statement>
		<statement id="scEncThreatPaid" text="scEncThreatPaid_text">
			<response_entry id="done" />
		</statement>
		<!-- the members' greetings (E3: "Can you come with me?" and "Would you join us?", one of its three variants) -->
		<statement id="scEncMemberNeutral" text="scEncMemberNeutral_text">
			<response_entry id="scEncWhereLeader" />
			<response_entry id="scEncEnlist" />
			<response_entry id="scEncRecruitAsk" />
			<response_entry id="scEncRecruitPoi" />
			<response_entry id="scEncRecruitSupplies" />
			<response_entry id="done" />
		</statement>
		<statement id="scEncMemberFriendly" text="scEncMemberFriendly_text">
			<response_entry id="scEncWhereLeader" />
			<response_entry id="scEncEnlist" />
			<response_entry id="scEncRecruitAsk" />
			<response_entry id="scEncRecruitPoi" />
			<response_entry id="scEncRecruitSupplies" />
			<response_entry id="done" />
		</statement>
		<statement id="scEncMemberAllied" text="scEncMemberAllied_text">
			<response_entry id="scEncWhereLeader" />
			<response_entry id="scEncEnlist" />
			<response_entry id="scEncRecruitAsk" />
			<response_entry id="scEncRecruitPoi" />
			<response_entry id="scEncRecruitSupplies" />
			<response_entry id="done" />
		</statement>
		<!-- "Where's your leader?" -->
		<statement id="scEncWhereReply" text="scEncWhereReply_text">
			<response_entry id="scEncMemberBackNeutral" />
			<response_entry id="scEncMemberBackFriendly" />
			<response_entry id="scEncMemberBackAllied" />
			<response_entry id="done" />
		</statement>

		<response id="scEncAbout" text="scEncAbout" nextstatementid="scEncAboutReply" />
		<response id="scEncThreat" text="scEncThreat" nextstatementid="scEncThreatConfirm" />
		<response id="scEncThreatYes" text="scEncThreatYes" nextstatementid="scEncThreatPaid">
			<requirement type="ScEncRole, SurvivorCommunity" requirementtype="Hide" value="leader" />
			<action type="ScEncThreat, SurvivorCommunity" />
		</response>
		<response id="scEncWhereLeader" text="scEncWhereLeader" nextstatementid="scEncWhereReply" />
		<!-- back to the greeting of the standing now: one of each three shows -->
		<response id="scEncForgetNeutral" text="scEncForget" nextstatementid="scEncLeaderNeutral">
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="neutral" />
		</response>
		<response id="scEncForgetFriendly" text="scEncForget" nextstatementid="scEncLeaderFriendly">
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="friendly" />
		</response>
		<response id="scEncForgetAllied" text="scEncForget" nextstatementid="scEncLeaderAllied">
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="allied" />
		</response>
		<response id="scEncLeaderBackNeutral" text="scEncBack" nextstatementid="scEncLeaderNeutral">
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="neutral" />
		</response>
		<response id="scEncLeaderBackFriendly" text="scEncBack" nextstatementid="scEncLeaderFriendly">
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="friendly" />
		</response>
		<response id="scEncLeaderBackAllied" text="scEncBack" nextstatementid="scEncLeaderAllied">
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="allied" />
		</response>
		<response id="scEncMemberBackNeutral" text="scEncBack" nextstatementid="scEncMemberNeutral">
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="neutral" />
		</response>
		<response id="scEncMemberBackFriendly" text="scEncBack" nextstatementid="scEncMemberFriendly">
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="friendly" />
		</response>
		<response id="scEncMemberBackAllied" text="scEncBack" nextstatementid="scEncMemberAllied">
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="allied" />
		</response>
	</append>

	<!-- Trade, enlist and recruit (E3, Enclaves_Plan.md 2.7-2.9; ScEnclaveDeals, DialogOpsEnclaves.cs). The leader's "Let's
	     trade." opens vanilla's trade window (Trader trade, as vanilla's traders: a non-hostile enclave's leader names a real
	     trader, ScEncCanTrade). A member's "Can you come with me?" leads to the terms ({terms}: the fee and the days at the
	     standing now) or shows greyed with the reason (one of them with you already, the follower limit, the dukes).
	     "Would you join us?" is one of three rows: scEncRecruitAsk to the confirm ({recruitcost}) or greyed with the reason
	     (a gate: SC's usual ones, the group still being made, the people left, the cooldown); at Neutral, before their favour
	     is done, scEncRecruitPoi / scEncRecruitSupplies into SC's own favour statements (their favour, rolled the first time,
	     unpinned and kept per person: ScEncFavour). SC's join rows in those statements need ScCanRecruit, which one of an
	     enclave's people never passes, so the enclave's own join rows go in beside them. One enlisted with the player has
	     their own statement (the phase scEncEnlisted): "Go home now." and the recruit rows (D9: a hire may join).
	     A greyed row shows its FIRST requirement's description (DialogResponse.GetRequiredDescription) and a row's
	     requirements stop at the first that fails: value="show" (Hide) comes first and gives the reason, then the others. -->
	<append xpath="/dialogs/dialog[@id='SdcsNPC']">
		<phase id="scEncEnlisted" startstatementid="scEncEnlisted">
			<requirement type="ScEncRole, SurvivorCommunity" value="enlisted" />
		</phase>

		<!-- one enlisted with the player ({until}: when they head home) -->
		<statement id="scEncEnlisted" text="scEncEnlisted_text">
			<response_entry id="scEncGoHome" />
			<response_entry id="scEncRecruitAsk" />
			<response_entry id="scEncRecruitPoi" />
			<response_entry id="scEncRecruitSupplies" />
			<response_entry id="done" />
		</statement>
		<!-- "Can you come with me?" -->
		<statement id="scEncEnlistConfirm" text="scEncEnlistConfirm_text">
			<response_entry id="scEncEnlistYes" />
			<response_entry id="scEncForgetMemberNeutral" />
			<response_entry id="scEncForgetMemberFriendly" />
			<response_entry id="scEncForgetMemberAllied" />
		</statement>
		<!-- "Would you join us?" with nothing left to do first -->
		<statement id="scEncRecruitConfirm" text="scEncRecruitConfirm_text">
			<response_entry id="scEncRecruitYes" />
			<response_entry id="scEncForgetMemberNeutral" />
			<response_entry id="scEncForgetMemberFriendly" />
			<response_entry id="scEncForgetMemberAllied" />
			<response_entry id="scEncForgetEnlisted" />
		</statement>

		<response id="scEncTrade" text="scEncTrade">
			<requirement type="ScEncCanTrade, SurvivorCommunity" requirementtype="Hide" />
			<action type="Trader" id="trade" />
		</response>
		<response id="scEncEnlist" text="scEncEnlist" nextstatementid="scEncEnlistConfirm">
			<requirement type="ScEncEnlist, SurvivorCommunity" requirementtype="Hide" value="show" />
			<requirement type="ScEncEnlist, SurvivorCommunity" value="open" />
		</response>
		<!-- checked again: the fee may have left the bag since the offer -->
		<response id="scEncEnlistYes" text="scEncEnlistYes">
			<requirement type="ScEncEnlist, SurvivorCommunity" requirementtype="Hide" value="show" />
			<requirement type="ScEncEnlist, SurvivorCommunity" value="open" />
			<action type="ScEncEnlist, SurvivorCommunity" />
		</response>
		<response id="scEncGoHome" text="scEncGoHome">
			<requirement type="ScEncRole, SurvivorCommunity" requirementtype="Hide" value="enlisted" />
			<action type="ScEncGoHome, SurvivorCommunity" />
		</response>
		<!-- "Would you join us?": one of the three shows -->
		<response id="scEncRecruitAsk" text="scEncRecruit" nextstatementid="scEncRecruitConfirm">
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="show" />
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="ask" />
			<requirement type="ScEncRecruit, SurvivorCommunity" value="open" />
		</response>
		<response id="scEncRecruitPoi" text="scEncRecruit" nextstatementid="scFavourPoi">
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="show" />
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="open" />
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="favour" />
			<requirement type="ScEncFavour, SurvivorCommunity" requirementtype="Hide" value="poi" />
			<action type="ScFavourBrief, SurvivorCommunity" />
		</response>
		<response id="scEncRecruitSupplies" text="scEncRecruit" nextstatementid="scFavourSupplies">
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="show" />
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="open" />
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="favour" />
			<requirement type="ScEncFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<action type="ScFavourBrief, SurvivorCommunity" />
		</response>
		<response id="scEncRecruitYes" text="scEncRecruitYes">
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="show" />
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="ask" />
			<requirement type="ScEncRecruit, SurvivorCommunity" value="open" />
			<action type="ScEncRecruit, SurvivorCommunity" />
		</response>
		<!-- the enclave's join rows in SC's favour statements: the supplies handed over in the talk, the POI already cleared -->
		<response id="scEncGiveSupplies" text="scGiveSupplies">
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="show" />
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="open" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScHasFavourItems, SurvivorCommunity" requirementtype="Hide" value="any" />
			<action type="ScTakeFavourItems, SurvivorCommunity" value="any" />
			<action type="ScEncRecruit, SurvivorCommunity" />
		</response>
		<response id="scEncPoiClearedJoin" text="scPoiClearedJoin">
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="show" />
			<requirement type="ScEncRecruit, SurvivorCommunity" requirementtype="Hide" value="open" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScEncRecruit, SurvivorCommunity" />
		</response>
		<!-- back to the greeting this person has now: one of the four shows -->
		<response id="scEncForgetMemberNeutral" text="scEncForget" nextstatementid="scEncMemberNeutral">
			<requirement type="ScEncRole, SurvivorCommunity" requirementtype="Hide" value="member" />
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="neutral" />
		</response>
		<response id="scEncForgetMemberFriendly" text="scEncForget" nextstatementid="scEncMemberFriendly">
			<requirement type="ScEncRole, SurvivorCommunity" requirementtype="Hide" value="member" />
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="friendly" />
		</response>
		<response id="scEncForgetMemberAllied" text="scEncForget" nextstatementid="scEncMemberAllied">
			<requirement type="ScEncRole, SurvivorCommunity" requirementtype="Hide" value="member" />
			<requirement type="ScEncStanding, SurvivorCommunity" requirementtype="Hide" value="allied" />
		</response>
		<response id="scEncForgetEnlisted" text="scEncForget" nextstatementid="scEncEnlisted">
			<requirement type="ScEncRole, SurvivorCommunity" requirementtype="Hide" value="enlisted" />
		</response>
	</append>
	<insertBefore xpath="/dialogs/dialog[@id='SdcsNPC']/statement[@id='scFavourSupplies']/response_entry[@id='done']">
		<response_entry id="scEncGiveSupplies" />
	</insertBefore>
	<insertBefore xpath="/dialogs/dialog[@id='SdcsNPC']/statement[@id='scPoiClearedReply']/response_entry[@id='scPoiLater']">
		<response_entry id="scEncPoiClearedJoin" />
	</insertBefore>
</configs>
