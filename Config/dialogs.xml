<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!--
	  Recruiting is injected into EVERY dialog that has a "Hire" response (XNPCCore's GenericNPC,
	  GenericNPCAnimal, GenericNPCNurse and any character pack that copies that shape), so installed NPC
	  packs join the pool without being listed here. The custom operators live in SurvivorCommunity.dll:
	  type="ScFavour, SurvivorCommunity" resolves to the global class DialogRequirementScFavour.

	  Flow (only once the player has a community home):
	         start -> "I could use someone like you in my community"   (scJoinPoi | scJoinSupplies)
	         -> favour statement (secure the nearest POI / bring N items)
	         POI:      "Mark it" (journal quest; ends the talk) ... scPoiDone (join)
	                   or, when the POI already reads clear, "Mark it" -> scPoiMarked -> scPoiAlreadyCleared
	                   -> scPoiClearedReply (join)
	         supplies: scAcceptSupplies "Sure, I'll see what I can find." (journal quest) ... scGiveSupplies (take + join),
	                   or scGiveSuppliesNow in the same talk when the items are already carried;
	                   scSuppliesDone (join) if the join was refused after the hand-over
	  A favour completes only through itself: the quest's clearing (or "Actually, I've already cleared that."), or the
	  supplies handed over.
	  Members get "Community" (opens the roster) and lose the vanilla Hire entry.
	-->

	<!-- menu entries, after the Hire entry in every statement that lists it -->
	<insertAfter xpath="/dialogs/dialog[response[@id='Hire']]/statement/response_entry[@id='Hire']">
		<response_entry id="scJoinPoi" />
		<response_entry id="scJoinSupplies" />
		<response_entry id="scPoiDone" />
		<response_entry id="scGiveSupplies" />
		<response_entry id="scSuppliesDone" />
		<response_entry id="scCommunity" />
		<response_entry id="scFollow" />
		<response_entry id="scGoHome" />
		<response_entry id="scRun" />
		<response_entry id="scRunHeadHome" />
		<response_entry id="scLeave" />
	</insertAfter>

	<!-- Members are managed from the community roster: the vanilla hire / order / dismiss / pick-up
	     entries disappear on them (a vanilla Dismiss or Follow on a member would fight the community's
	     own stationing). Weapon swaps and "show me your inventory" stay. 0-XNPCCore 3.2's route recording
	     (SetPatrolPoint "Show me a route", CancelPatrolRecord) is hidden too. Since migration M2 the ticker keeps a
	     follower's voice / order-wheel orders (stay, guard, wander, a route) as member states, so these command rows
	     COULD be offered to followers; they stay hidden until the user decides (the order wheel and "@name" commands
	     already give the same orders). -->
	<append xpath="/dialogs/dialog/response[@id='Hire' or @id='Dismiss' or @id='FollowMe' or @id='StayHere' or @id='GuardHere' or @id='GuardReturnHere' or @id='Wander' or @id='Patrol' or @id='Loot' or @id='SetCode' or @id='Pickup' or @id='SetPatrolPoint' or @id='CancelPatrolRecord']">
		<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" operator="not" />
		<!-- an outpost / distress stand-in is that member too: nobody hires, orders or picks it up -->
		<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_standin" operator="not" />
	</append>

	<append xpath="/dialogs/dialog[response[@id='Hire']]">
		<!-- ask to join: one of the two shows, depending on the favour rolled for this NPC. Who may be asked is
		     ScCanRecruit's call: since migration M2 (decision D9) that includes a companion YOU hired the vanilla way -
		     joining ends the paid hire - but never somebody else's hire. Nothing is offered (or rolled: requirements stop
		     at the first that fails) before the player has a community home. -->
		<response id="scJoinPoi" text="scJoinPoi" nextstatementid="scFavourPoi">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="poi" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<action type="ScFavourBrief, SurvivorCommunity" />
		</response>
		<response id="scJoinSupplies" text="scJoinSupplies" nextstatementid="scFavourSupplies">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<action type="ScFavourBrief, SurvivorCommunity" />
		</response>

		<statement id="scFavourPoi" text="scFavourPoi_text">
			<response_entry id="scStartPoi" />
			<response_entry id="scStartPoiCleared" />
			<response_entry id="done" />
		</statement>
		<statement id="scFavourSupplies" text="scFavourSupplies_text">
			<response_entry id="scGiveSuppliesNow" />
			<response_entry id="scAcceptSupplies" />
			<response_entry id="done" />
		</statement>

		<!-- POI favour. "Mark it" puts the quest in the journal. Two of them, one shown: when the POI does not read clear
		     it just ends the talk; when it already does (the test vanilla's quest uses), the survivor answers and the
		     player can say so - that completes the favour and closes the quest. -->
		<response id="scStartPoi" text="scStartPoi">
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScFavourPoiCleared, SurvivorCommunity" requirementtype="Hide" value="not" />
			<action type="ScStartPoiQuest, SurvivorCommunity" />
		</response>
		<response id="scStartPoiCleared" text="scStartPoi" nextstatementid="scPoiMarked">
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScFavourPoiCleared, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScStartPoiQuest, SurvivorCommunity" />
		</response>
		<statement id="scPoiMarked" text="scPoiMarked_text">
			<response_entry id="scPoiAlreadyCleared" />
			<response_entry id="scPoiOnIt" />
		</statement>
		<response id="scPoiOnIt" text="scPoiOnIt" />
		<response id="scPoiAlreadyCleared" text="scPoiAlreadyCleared" nextstatementid="scPoiClearedReply">
			<requirement type="ScFavourPoiCleared, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScFavourPoiCleared, SurvivorCommunity" />
		</response>
		<statement id="scPoiClearedReply" text="scPoiClearedReply_text">
			<response_entry id="scPoiClearedJoin" />
			<response_entry id="scPoiLater" />
		</statement>
		<response id="scPoiLater" text="scPoiLater" />
		<response id="scPoiClearedJoin" text="scPoiClearedJoin">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>
		<!-- shown at the root once the favour is done (the quest's clearing, or "Actually, I've already cleared that.") -->
		<response id="scPoiDone" text="scPoiDone">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="poi" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>

		<!-- supplies favour. "Sure, I'll see what I can find." takes it on (journal quest, marker on the survivor; ends
		     the talk). The hand-over: at the root while the items are carried, once taken on (scGiveSupplies), or in the
		     answer itself when they are carried already (scGiveSuppliesNow). -->
		<response id="scAcceptSupplies" text="scAcceptSupplies">
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScFavourQuestOpen, SurvivorCommunity" requirementtype="Hide" value="not" />
			<action type="ScStartSuppliesQuest, SurvivorCommunity" />
		</response>
		<!-- shown at the root if the join was refused after the supplies were handed over -->
		<response id="scSuppliesDone" text="scSuppliesDone">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>
		<response id="scGiveSupplies" text="scGiveSupplies">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScHasFavourItems, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScTakeFavourItems, SurvivorCommunity" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>
		<response id="scGiveSuppliesNow" text="scGiveSupplies">
			<requirement type="ScCanRecruit, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScHasHome, SurvivorCommunity" requirementtype="Hide" />
			<requirement type="ScFavour, SurvivorCommunity" requirementtype="Hide" value="supplies" />
			<requirement type="ScFavourDone, SurvivorCommunity" requirementtype="Hide" value="not" />
			<requirement type="ScHasFavourItems, SurvivorCommunity" requirementtype="Hide" value="any" />
			<action type="ScTakeFavourItems, SurvivorCommunity" value="any" />
			<action type="ScJoin, SurvivorCommunity" />
		</response>

		<!-- members: open the roster, and the three orders (the vanilla hire / dismiss entries are hidden on them) -->
		<response id="scCommunity" text="scCommunity">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
			<action type="ScOpenCommunity, SurvivorCommunity" />
		</response>
		<response id="scFollow" text="scFollow">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_following" operator="not" />
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_onrun" operator="not" />
			<action type="ScFollow, SurvivorCommunity" />
		</response>
		<response id="scGoHome" text="scGoHome">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_following" value="1" />
			<action type="ScGoHome, SurvivorCommunity" />
		</response>
		<response id="scRun" text="scRun" nextstatementid="scRunPick">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_onrun" operator="not" />
		</response>
		<!-- a runner met out in the world: turn round -->
		<response id="scRunHeadHome" text="scRunHeadHome">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_onrun" value="1" />
			<action type="ScRecall, SurvivorCommunity" />
		</response>
		<statement id="scRunPick" text="scRunPick_text">
			<response_entry id="scRunFood" />
			<response_entry id="scRunWater" />
			<response_entry id="scRunMeds" />
			<response_entry id="scRunAmmo" />
			<response_entry id="scRunMaterials" />
			<response_entry id="scRunFuel" />
			<response_entry id="done" />
		</statement>
		<response id="scRunFood" text="scRunFood"><action type="ScRun, SurvivorCommunity" value="food" /></response>
		<response id="scRunWater" text="scRunWater"><action type="ScRun, SurvivorCommunity" value="water" /></response>
		<response id="scRunMeds" text="scRunMeds"><action type="ScRun, SurvivorCommunity" value="meds" /></response>
		<response id="scRunAmmo" text="scRunAmmo"><action type="ScRun, SurvivorCommunity" value="ammo" /></response>
		<response id="scRunMaterials" text="scRunMaterials"><action type="ScRun, SurvivorCommunity" value="mats" /></response>
		<response id="scRunFuel" text="scRunFuel"><action type="ScRun, SurvivorCommunity" value="fuel" /></response>
		<response id="scLeave" text="scLeave" nextstatementid="scLeaveConfirm">
			<requirement type="NPCHasCVarSDX, SCore" requirementtype="Hide" id="sc_member" value="1" />
		</response>
		<statement id="scLeaveConfirm" text="scLeaveConfirm_text">
			<response_entry id="scLeaveYes" />
			<response_entry id="done" />
		</statement>
		<response id="scLeaveYes" text="scLeaveYes">
			<action type="ScLeave, SurvivorCommunity" />
		</response>
	</append>

	<!-- The weapon menu (0-XNPCCore's "Weapon Classes", shown to the NPC's leader) lists vanilla weapons only, so a gun from
	     a weapon pack (IZY Classic) handed over through the inventory window had no "Use" line. This one takes the best
	     gun or bow and the best melee weapon from the window that the survivors can carry (XnpcWeapons) into the pair and
	     the hand, the replaced ones coming back to you (ScArms.UseHanded). Hidden when there is none. ONE line: the
	     dialog shows ten responses at most and 0-XNPCCore's weapon menu has nine. -->
	<insertBefore xpath="/dialogs/dialog/statement[@id='Weapon Classes']/response_entry[1]">
		<response_entry id="scUseHanded" />
	</insertBefore>
	<append xpath="/dialogs/dialog[statement[@id='Weapon Classes']]">
		<response id="scUseHanded" text="scUseHanded">
			<requirement type="ScHandedWeapon, SurvivorCommunity" requirementtype="Hide" />
			<action type="ScUseHanded, SurvivorCommunity" />
		</response>
	</append>
</configs>
