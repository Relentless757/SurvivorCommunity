<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!-- Resource bundles: the community's five resources in item form, made at the packing station and
	     deposited into the stockpile there, and found in loot / trader quest rewards (Config/loot.xml).
	     Deliberately NO OpenBundle action (a bundle that unpacked into goods would make the station a free item
	     converter) and not sellable. Icons are the matching vanilla loot piles (Data/ItemIcons). -->
	<append xpath="/items">
		<item name="scBundleMaster">
			<property name="CreativeMode" value="None"/>
			<property name="ItemTypeIcon" value="bundle"/>
			<property name="HoldType" value="45"/>
			<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="Material" value="Mmetal"/>
			<property name="Stacknumber" value="10"/>
			<property name="Weight" value="0"/>
			<property name="EconomicValue" value="1"/>
			<property name="SellableToTrader" value="false"/>
			<property name="Group" value="Special Items"/>
			<property name="SoundPickup" value="ammobox_grab"/>
			<property name="SoundPlace" value="ammobox_place"/>
		</item>
		<item name="scBundleFood">
			<property name="Extends" value="scBundleMaster"/>
			<property name="CreativeMode" value="Player"/>
			<property name="CustomIcon" value="cntFoodPileMedium"/>
			<property name="Tags" value="scbundle,scfood"/>
		</item>
		<item name="scBundleMeds">
			<property name="Extends" value="scBundleMaster"/>
			<property name="CreativeMode" value="Player"/>
			<property name="CustomIcon" value="cntMedicLootPileB"/>
			<property name="Tags" value="scbundle,scmeds"/>
		</item>
		<item name="scBundleAmmo">
			<property name="Extends" value="scBundleMaster"/>
			<property name="CreativeMode" value="Player"/>
			<property name="CustomIcon" value="cntAmmoPileMedium"/>
			<property name="Tags" value="scbundle,scammo"/>
		</item>
		<item name="scBundleMaterials">
			<property name="Extends" value="scBundleMaster"/>
			<property name="CreativeMode" value="Player"/>
			<property name="CustomIcon" value="cinderBlocks02"/>
			<property name="Tags" value="scbundle,scmaterials"/>
		</item>
		<item name="scBundleFuel">
			<property name="Extends" value="scBundleMaster"/>
			<property name="CreativeMode" value="Player"/>
			<property name="CustomIcon" value="cntBarrelGasSingle00"/>
			<property name="Tags" value="scbundle,scfuel"/>
		</item>
	</append>
	<!-- IZY Classic's replacement Hunting Rifle (IGP_Classic with Combat Sandbox, unless Disable_VRP) lost vanilla's
	     T1,weapon,ranged tags, so 0-XNPCCore took it for a melee weapon and survivors and raiders carrying one walked up
	     and clubbed with it (found 2026-10-08). The add skips any tag it already has. -->
	<conditional>
		<if cond="mod_loaded('IGP_Classic') and mod_loaded('Combat_Sandbox_FLTR')">
			<conditional>
				<if cond="mod_loaded('Disable_VRP') == false">
					<csv xpath="/items/item[@name='gunRifleT1HuntingRifle']/property[@name='Tags']/@value" delim="," op="add">T1,weapon,ranged</csv>
				</if>
			</conditional>
		</if>
	</conditional>
</configs>
