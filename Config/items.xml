<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!-- Resource bundles: the community's resources in item form, made at the packing station and deposited into the
	     stockpile there, and found in loot / trader quest rewards (Config/loot.xml; never water). Round wl: three sizes,
	     Small / Medium / Large = 1 / 2 / 3 stockpile units (ScNames.TryBundle reads the size from the name), for food,
	     water, medical, ammo, materials, fuel and luxuries; the old one-size scBundle<Res> items stay valid (one unit)
	     but nothing makes or drops them. Deliberately NO OpenBundle action (a bundle that unpacked into goods would
	     make the station a free item converter) and not sellable. Icons are the matching vanilla loot piles and barrels
	     (Data/ItemIcons). -->
	<append xpath="/items">
		<item name="scBundleMaster">
			<property name="CreativeMode" value="None"/>
			<property name="ItemTypeIcon" value="bundle"/>
			<property name="HoldType" value="45"/>
			<property name="Meshfile" value="@:Other/Items/Misc/sackPrefab.prefab"/>
			<property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>
			<property name="Material" value="Mmetal"/>
			<property name="Stacknumber" value="10"/>
			<property name="Weight" value="0"/>
			<property name="EconomicValue" value="1"/>
			<property name="SellableToTrader" value="false"/>
			<property name="Group" value="Special Items"/>
			<property name="SoundPickup" value="ammobox_grab"/>
			<property name="SoundPlace" value="ammobox_place"/>
		</item>
		<item name="scBundleFood">
			<property name="Extends" value="scBundleMaster"/>
			<property name="CreativeMode" value="None"/>
			<property name="CustomIcon" value="cntFoodPileMedium"/>
			<property name="Tags" value="scbundle,scfood"/>
		</item>
		<item name="scBundleMeds">
			<property name="Extends" value="scBundleMaster"/>
