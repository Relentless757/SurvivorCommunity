<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!-- The community window's modal group, a page of the player menu since W1: the Community tab left of the tab bar
	     (windows.xml) opens it, and so does C# (ScCommunity.OpenWindow) from the ESC menu entry, the land claim radial
	     and a member's dialog. Its controller XUiC_ScPageGroup keeps the tab bar ("windowpaging") open while it shows,
	     as vanilla's page groups do. Deliberately NO actionset attribute: actionset="false" leaves such a group
	     unclickable. -->
	<append xpath="/xui">
		<window_group name="sccommunity" controller="SurvivorCommunity.ScPageGroup, SurvivorCommunity" close_compass_on_open="true">
			<window name="windowScCommunity"/>
		</window_group>
		<window_group name="scradio" close_compass_on_open="true">
			<window name="windowScRadio"/>
		</window_group>
	</append>
	<!-- The Home Status panel rides the HUD's toolbelt group, which is open whenever the HUD is. -->
	<append xpath="/xui/window_group[@name='toolbelt']">
		<window name="windowScHomeStatus"/>
	</append>
	<!-- The survivor snapshot rides the NPC dialog's own group, so it opens and closes with every conversation; its
	     controller shows it only for a survivor (XUiC_ScSnapshot). -->
	<append xpath="/xui/window_group[@name='dialog']">
		<window name="windowScSnapshot"/>
	</append>
	<!-- The NPC's line above the responses (XUiC_ScDialogLine): vanilla's dialog group shows only the responses. -->
	<append xpath="/xui/window_group[@name='dialog']">
		<window name="windowScDialogLine"/>
	</append>
</configs>
