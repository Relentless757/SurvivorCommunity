<?xml version="1.0" encoding="UTF-8" ?>
<configs>
	<!-- The community window's modal group, a page of the player menu since W1: the Community tab left of the tab bar
	     (windows.xml) opens it, and so does C# (ScCommunity.OpenWindow) from the ESC menu entry, the land claim radial
	     and a member's dialog. Its controller XUiC_ScPageGroup keeps the tab bar ("windowpaging") open while it shows,
	     as vanilla's page groups do. Deliberately NO actionset attribute: actionset="false" leaves such a group
	     unclickable. -->
	<append xpath="/xui">
		<window_group name="sccommunity" controller="SurvivorCommunity.ScPageGroup, SurvivorCommunity" close_compass_on_open="true">
			<window name="windowScCommunity"/>
		</window_group>
		<!-- R2 (round 27): the radio station's window is a page of the player menu too - the Radio tab (windows.xml), shown
		     while a handheld radio is carried, opens it from anywhere; the same controller keeps the tab bar with it. Opened at
		     a radio block without a handheld (no tab) it opens on its own, as before. -->
		<window_group name="scradio" controller="SurvivorCommunity.ScPageGroup, SurvivorCommunity" close_compass_on_open="true">
			<window name="windowScRadio"/>
		</window_group>
	</append>
	<!-- The Home Status panel rides the HUD's toolbelt group, which is open whenever the HUD is. -->
	<append xpath="/xui/window_group[@name='toolbelt']">
		<window name="windowScHomeStatus"/>
	</append>
	<!-- The survivor snapshot rides the NPC dialog's own group, so it opens and closes with every conversation; its
	     controller shows it only for a survivor (XUiC_ScSnapshot). -->
	<append xpath="/xui/window_group[@name='dialog']">
		<window name="windowScSnapshot"/>
	</append>
	<!-- The NPC's line above the responses (XUiC_ScDialogLine): vanilla's dialog group shows only the responses. -->
	<append xpath="/xui/window_group[@name='dialog']">
		<window name="windowScDialogLine"/>
	</append>
	<!-- Round n10: the member inventory panel. "Show me your inventory" on one of the community's members opens this group
	     instead of vanilla's "looting" (Patches_MemberInv); XUiC_ScMemberInvGroup opens the "backpack" group beside it as
	     vanilla's looting does. Like "looting" it has the non-paging header and its left panel aligned at the bottom: the
	     spacer windowScMemberInvSpace takes the looting window's place in the Left stack panel, so the backpack's columns
	     lay out as for looting; windowScMemberInv itself is anchored and draggable. Deliberately NO actionset attribute: a
	     group opened on its own with actionset="false" takes no input. -->
	<append xpath="/xui">
		<window_group name="scmemberinv" left_panel_valign_top="false" controller="SurvivorCommunity.ScMemberInvGroup, SurvivorCommunity" close_compass_on_open="true">
			<window name="windowScMemberInv"/>
			<window name="windowScMemberInvSpace"/>
			<window name="windowNonPagingHeader"/>
		</window_group>
	</append>
	<!-- Round s1: SC's own linked storage window (windowScLinkedStorage, Tools/generate_linked_storage_ui.py). Without RE
	     Inventory, linked storage opens here instead of "looting" (ScStorage.OwnWindowGroup): vanilla's looting window has
	     90 cells, this one 360 in a scrolling view. Otherwise it is "looting": vanilla's XUiC_LootWindowGroup (OpenLooting
	     opens the "backpack" group beside it), the non-paging header, its left panel aligned at the bottom, and no
	     actionset attribute. -->
	<append xpath="/xui">
		<window_group name="sclinkedstorage" left_panel_valign_top="false" controller="XUiC_LootWindowGroup" close_compass_on_open="true">
			<window name="windowScLinkedStorage"/>
			<window name="windowNonPagingHeader"/>
		</window_group>
	</append>
	<!-- Round ui1 (research/uicompat/steelshot.md 6.5): Steelshot UI puts its glass backdrop behind each standalone page
	     (map, skills, quests ...); the same behind SC's two pages. Their windows (depth 20) and its header (100) stay above it. -->
	<conditional>
		<if cond="mod_loaded('SteelshotUi') and not mod_loaded('zzzzz_AshfallUI')">
			<append xpath="/xui/window_group[@name='sccommunity']">
				<window name="steelshotUiPanelBackdrop"/>
			</append>
			<append xpath="/xui/window_group[@name='scradio']">
				<window name="steelshotUiPanelBackdrop"/>
			</append>
		</if>
	</conditional>
</configs>
