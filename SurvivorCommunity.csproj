    <!-- The NPC framework: EntityAliveSDX and EntityAliveSDXV4 (ScNpc.cs is the type seam), EntityUtilities,
         SphereCache, IEntityOrderReceiverSDX, the dialog/UAI base classes SCore adds. Hard dependency (ModApi
         checks it at runtime too). -->
    <Reference Include="SCore">
      <HintPath>$(GameDir)\Mods\0-SCore\SCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 0-XNPCCore 3.2's player-body survivors: EModelSdcsNpc, AvatarSdcsNpcController and MinEventActionSdcsApplyLook
         (public types; their private methods are bound by name in Patches_Xnpc). Hard dependency like SCore (ModApi
         probes it at runtime); never copied next to our DLL, the game loads 0-XNPCCore's own. -->
    <Reference Include="NPCSdcsCharacters">
      <HintPath>$(GameDir)\Mods\0-XNPCCore\NPCSdcsCharacters.dll</HintPath>
